{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": [
        "apps/web/src/*"
      ],
      "@admin/*": [
        "apps/admin/src/*"
      ],
      "@driver/*": [
        "apps/driver/src/*"
      ],
      "@ui/*": [
        "packages/ui/src/*"
      ],
      "@config/*": [
        "packages/config/src/*"
      ],
      "@realtime/*": [
        "packages/realtime/src/*"
      ],
      "@maps/*": [
        "packages/maps/src/*"
      ],
      "@auth/*": [
        "packages/auth/src/*"
      ]
    }
  }
}
