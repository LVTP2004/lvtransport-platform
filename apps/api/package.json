{
  "name": "@lvtransport/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "incident:cognition": "tsx src/cli/ops-cli.ts incident:cognition",
    "incident:explain": "tsx src/cli/ops-cli.ts incident:explain",
    "snapshot:create": "tsx src/cli/ops-cli.ts snapshot:create",
    "snapshot:list": "tsx src/cli/ops-cli.ts snapshot:list",
    "snapshot:verify": "tsx src/cli/ops-cli.ts snapshot:verify",
    "snapshot:restore-dry-run": "tsx src/cli/ops-cli.ts snapshot:restore-dry-run",
    "anomaly:scan": "tsx src/cli/ops-cli.ts incident:explain",
    "anomaly:report": "tsx src/cli/ops-cli.ts incident:explain",
    "lineage:verify": "tsx src/cli/ops-cli.ts incident:explain",
    "lineage:audit": "tsx src/cli/ops-cli.ts incident:explain",
    "constitution:verify": "tsx src/cli/ops-cli.ts incident:explain",
    "narrative:generate": "tsx src/cli/ops-cli.ts incident:explain"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "ws": "^8.18.0",
    "@lvtransport/realtime": "workspace:*",
    "@lvtransport/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@lvtransport/config": "workspace:*"
  }
}
