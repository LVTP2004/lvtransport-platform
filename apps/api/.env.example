NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
APP_NAME=lvtransport-api

# Runtime safety / proxy
TRUST_PROXY=false
JWT_SECRET=dev-insecure-secret-change-me

# Maps + routing
GOOGLE_MAPS_API_KEY=
MAPS_DEFAULT_SPEED_KPH=38
MAPS_ROAD_FACTOR=1.25

# Optional payment + communications integrations
STRIPE_SECRET_KEY=
PAYCONIQ_API_KEY=
MAIL_PROVIDER_API_KEY=
MAIL_FROM_ADDRESS=

# Firebase shared architecture (no production keys)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_USE_EMULATORS=true

GOOGLE_MAPS_SERVER_KEY=__SERVER_KEY_PLACEHOLDER__
GOOGLE_MAPS_PLACES_PROXY_ENABLED=true
